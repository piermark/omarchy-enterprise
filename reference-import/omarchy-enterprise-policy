#!/usr/bin/python3

import os
import sys
import grp
import pwd
import json
import re
import stat
import tempfile

from pathlib import Path
from urllib.parse import urlsplit

VERSION = "0.1.0"

CONFIG = Path("/etc/omarchy-enterprise/policy.json")
PREFIX = "omarchy-enterprise-share-"
MARKER = "X-Omarchy-Enterprise-Managed=true"

def validate(config):
    if not isinstance(config, dict):
        raise ValueError("Invalid policy document")

    if config.get("schema_version") != 1:
        raise ValueError("Unsupported policy schema")

    shares = config.get("shares")

    if not isinstance(shares, list):
        raise ValueError("Invalid shares list")

    seen = set()

    for share in shares:

        if not isinstance(share, dict):
            raise ValueError("Invalid share entry")

        identifier = share.get("id", "")
        label = share.get("label", "")
        uri = share.get("uri", "")
        groups = share.get("groups", [])

        if not isinstance(identifier, str) or not re.fullmatch(
            r"[a-z0-9][a-z0-9-]{0,63}", identifier
        ):
            raise ValueError("Invalid share ID")

        if identifier in seen:
            raise ValueError("Duplicate share ID")

        seen.add(identifier)

        if not isinstance(label, str) or not label.strip():
            raise ValueError("Invalid share label")

        if any(ord(c) < 32 or c == "\\" for c in label):
            raise ValueError("Invalid label characters")

        if not isinstance(uri, str) or any(
            ord(c) < 33 or ord(c) > 126 or c == "\\"
            for c in uri
        ):
            raise ValueError("Invalid SMB URI")

        parsed = urlsplit(uri)

        if (
            parsed.scheme != "smb"
            or not parsed.hostname
            or not re.fullmatch(
                r"[A-Za-z0-9.-]+", parsed.hostname
            )
            or parsed.username is not None
            or parsed.password is not None
            or parsed.netloc != parsed.hostname
            or parsed.query
            or parsed.fragment
            or not parsed.path.strip("/")
        ):
            raise ValueError("Invalid SMB destination")

        if (
            not isinstance(groups, list)
            or not groups
            or not all(
                isinstance(g, str) and g.strip()
                for g in groups
            )
        ):
            raise ValueError("Invalid group assignment")

    return shares

def load():
    metadata = CONFIG.lstat()

    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != 0
        or metadata.st_mode & 0o022
    ):
        raise PermissionError("Unsafe policy permissions")

    return validate(
        json.loads(CONFIG.read_text())
    )

def resolve(shares, group_matches):
    selected = []

    for share in shares:
        matches = [
            group_matches(name)
            for name in share["groups"]
        ]

        if any(matches):
            selected.append(share)

    return selected

def session_group(name):
    gids = set(os.getgroups()) | {os.getgid()}

    try:
        return grp.getgrnam(name).gr_gid in gids
    except KeyError:
        raise ValueError("Unresolved group: " + name)

def render(share):
    return "\n".join([
        "[Desktop Entry]",
        "Type=Application",
        "Name=" + share["label"],
        "Comment=Enterprise network share",
        "Icon=folder-remote",
        "Exec=/usr/local/bin/omarchy-enterprise-policy open "
            + share["id"],
        "Terminal=false",
        "Categories=Network;",
        MARKER,
        ""
    ])

def atomic_write(path, content):
    temporary = None

    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            dir=path.parent,
            encoding="utf-8",
            delete=False
        ) as handle:
            temporary = Path(handle.name)
            handle.write(content)

        os.replace(temporary, path)

    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)

def managed(path):
    return (
        not path.is_symlink()
        and path.is_file()
        and path.stat().st_uid == os.getuid()
        and MARKER in path.read_text().splitlines()
    )

def apply_policy(shares, directory):
    directory.mkdir(parents=True, exist_ok=True)

    desired = {
        directory / (PREFIX + share["id"] + ".desktop"):
        render(share)
        for share in shares
    }

    # Never overwrite unmanaged launchers.

    for path in desired:
        if path.exists() or path.is_symlink():
            if not managed(path):
                raise PermissionError(
                    "Unmanaged launcher collision: " + str(path)
                )

    for path, content in desired.items():
        if not path.exists() or path.read_text() != content:
            atomic_write(path, content)
            print("Applied:", path.name)

    for path in directory.glob(PREFIX + "*.desktop"):
        if path not in desired and managed(path):
            path.unlink()
            print("Removed:", path.name)

    print("Managed network shares:", len(desired))

def self_test():

    example = {
        "schema_version": 1,
        "shares": [
            {
                "id": "documents",
                "label": "Company Documents",
                "uri": "smb://files.example.com/documents",
                "groups": ["employees@example.com"]
            }
        ]
    }

    shares = validate(example)

    selected = resolve(
        shares,
        lambda name: name == "employees@example.com"
    )

    assert len(selected) == 1
    assert resolve(shares, lambda name: False) == []

    with tempfile.TemporaryDirectory() as temporary:

        directory = Path(temporary)

        personal = directory / "personal.desktop"
        personal.write_text("Personal launcher")

        apply_policy(selected, directory)

        launcher = directory / (
            PREFIX + "documents.desktop"
        )

        assert launcher.is_file()
        assert MARKER in launcher.read_text()

        apply_policy([], directory)

        assert not launcher.exists()
        assert personal.read_text() == "Personal launcher"

    print("Policy self-test: PASS")

def main():

    command = sys.argv[1] if len(sys.argv) > 1 else "plan"

    if command == "self-test":
        self_test()
        return

    if command == "validate":
        shares = load()
        print("Policy configuration: VALID")
        print("Configured shares:", len(shares))
        return

    if os.geteuid() == 0:
        sys.exit("Run user policies without sudo.")

    shares = load()
    selected = resolve(shares, session_group)

    user = pwd.getpwuid(os.getuid())

    if command == "plan":

        print("========================================")
        print("     OMARCHY ENTERPRISE GROUP POLICY")
        print("              v" + VERSION)
        print("========================================")
        print("User:", user.pw_name)
        print("Assigned shares:", len(selected))

        for share in selected:
            print(share["id"], "|", share["label"])
            print("  " + share["uri"])

        print("No configuration changes were made.")

    elif command == "apply":

        directory = Path(user.pw_dir) / \
            ".local/share/applications"

        apply_policy(selected, directory)

    elif command == "open":

        if len(sys.argv) != 3:
            sys.exit("Specify a share ID.")

        for share in selected:
            if share["id"] == sys.argv[2]:
                os.execv(
                    "/usr/bin/gio",
                    ["gio", "open", share["uri"]]
                )

        sys.exit("Share not assigned to this session.")

    else:
        sys.exit(
            "Commands: validate, plan, apply, open, self-test"
        )

if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, KeyError) as error:
        sys.exit("Policy error: " + str(error))
