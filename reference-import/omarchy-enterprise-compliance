#!/usr/bin/python3

import os
import sys
import json
import re
import ipaddress
import subprocess
from pathlib import Path
from datetime import datetime, timezone

VERSION = "0.1.1"
results = []

if os.geteuid() != 0:
    sys.exit("Please run with sudo.")

def run(*args):
    try:
        p = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=25,
            env=dict(os.environ, LC_ALL="C")
        )
        return p.returncode, p.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return None, ""

def check(name, status, detail):
    results.append({
        "check": name,
        "status": status,
        "detail": detail
    })

# Root disk encryption

rc, source = run("findmnt", "-n", "-o", "SOURCE", "/")

if rc == 0:
    device = source.split("[", 1)[0]

    rc, storage = run(
        "lsblk", "-s", "-n", "-r",
        "-o", "FSTYPE", device
    )

    if rc == 0:
        encrypted = "crypto_LUKS" in storage.splitlines()

        check("Root Disk Encryption",
              "PASS" if encrypted else "WARN",
              "LUKS detected" if encrypted else "LUKS not detected")
    else:
        check("Root Disk Encryption", "UNKNOWN",
              "Unable to inspect root device")
else:
    check("Root Disk Encryption", "UNKNOWN",
          "Unable to identify root device")

# Secure Boot and TPM

rc, boot = run("bootctl", "status", "--no-pager")

match = re.search(r"Secure Boot:\s*([^\n]+)", boot)

if match:
    value = match.group(1).strip()
    check("Secure Boot",
          "PASS" if value.startswith("enabled") else "WARN",
          value)
else:
    check("Secure Boot", "UNKNOWN", "Status unavailable")

match = re.search(r"TPM2 Support:\s*([^\n]+)", boot)

if match:
    value = match.group(1).strip()
    check("TPM 2.0",
          "PASS" if value == "yes" else "WARN",
          value)
else:
    check("TPM 2.0", "UNKNOWN", "Status unavailable")

# Firewall

rc, firewall = run("ufw", "status", "verbose")

if rc == 0 and "Status: active" in firewall:

    if re.search(r"Default:\s*(deny|reject) \(incoming\)", firewall):
        check("UFW Default Input Policy", "PASS",
              "Active with restrictive default input policy")
    else:
        check("UFW Default Input Policy", "WARN",
              "Active, default input policy requires review")

elif rc == 0 and "Status: inactive" in firewall:
    check("UFW Default Input Policy", "WARN", "UFW inactive")
else:
    check("UFW Default Input Policy", "UNKNOWN",
          "UFW status unavailable")

check("Firewall Rules Review", "REVIEW",
      "Explicit allow rules require administrator review")

# Network exposure

rc, sockets = run("ss", "-H", "-lntu")

def check_port(port, label):
    if rc != 0:
        check(label, "UNKNOWN", "Socket inspection failed")
        return

    addresses = []

    for line in sockets.splitlines():
        fields = line.split()

        if len(fields) < 5:
            continue

        address, sep, number = fields[4].rpartition(":")

        if sep and number == str(port):
            addresses.append(address.strip("[]").split("%")[0])

    if not addresses:
        check(label, "N/A", "No listening socket detected")
        return

    local = True

    for address in addresses:
        try:
            if not ipaddress.ip_address(address).is_loopback:
                local = False
        except ValueError:
            local = False

    check(label,
          "PASS" if local else "REVIEW",
          "Loopback only" if local else "Non-loopback listener detected")

check_port(631, "CUPS Network Binding")
check_port(3389, "RDP Network Binding")
check_port(22, "SSH Network Binding")

# SSH effective global configuration

rc, ssh = run("sshd", "-T")

if rc == 0:
    settings = {}

    for line in ssh.splitlines():
        key, _, value = line.partition(" ")
        settings[key.lower()] = value.strip().lower()

    for key, label in [
        ("permitrootlogin", "SSH Root Login"),
        ("passwordauthentication", "SSH Password Authentication"),
        ("permitemptypasswords", "SSH Empty Passwords")
    ]:
        value = settings.get(key)

        if value is None:
            check(label, "UNKNOWN", "Setting unavailable")
        else:
            check(label,
                  "PASS" if value == "no" else "REVIEW",
                  value)
else:
    check("SSH Configuration", "UNKNOWN", "Unable to inspect sshd")

# Docker

rc, docker = run("systemctl", "is-active", "docker.service")

if docker == "active":
    check("Docker Network Isolation", "REVIEW",
          "Container ports and local user access require review")
else:
    check("Docker Network Isolation", "UNKNOWN",
          "Docker not active or unavailable")

# NTP

rc, ntp = run(
    "timedatectl", "show",
    "--property=NTPSynchronized", "--value"
)

check("NTP Synchronization",
      "PASS" if rc == 0 and ntp == "yes"
      else "WARN" if rc == 0 else "UNKNOWN",
      ntp or "Status unavailable")

# Active Directory

rc, output = run(
    "/usr/local/bin/omarchy-enterprise-ad-testjoin"
)

check("Active Directory Trust",
      "PASS" if rc == 0 and "Join is OK" in output
      else "FAIL" if rc is not None else "UNKNOWN",
      "Machine trust verified" if rc == 0 and "Join is OK" in output
      else "Trust verification unsuccessful")

# Configuration integrity

rc, output = run(
    "/usr/bin/bash", "/usr/local/bin/omarchy-enterprise-guard", "check"
)

check("Configuration Integrity",
      "PASS" if rc == 0 and
      "Enterprise integrity check passed." in output
      else "WARN" if rc is not None else "UNKNOWN",
      "Baseline verified" if rc == 0 and
      "Enterprise integrity check passed." in output
      else "Baseline requires review")

# Failed systemd units

rc, failed = run(
    "systemctl", "--failed",
    "--no-legend", "--plain", "--no-pager"
)

check("System Services",
      "PASS" if rc == 0 and not failed
      else "WARN" if rc == 0 else "UNKNOWN",
      "No failed units" if rc == 0 and not failed
      else "Inspect failed systemd units")

# Audit

rc, audit = run("auditctl", "-s")
match = re.search(r"^enabled\s+([012])", audit, re.M)

if rc == 0 and match:
    enabled = match.group(1) in ("1", "2")
    check("Kernel Auditing",
          "PASS" if enabled else "WARN",
          "Enabled" if enabled else "Disabled")
else:
    check("Kernel Auditing", "UNKNOWN", "Status unavailable")

rc, auditd = run("systemctl", "is-active", "auditd.service")

check("Audit Logging Service",
      "PASS" if auditd == "active"
      else "WARN" if auditd == "inactive" else "UNKNOWN",
      auditd or "Status unavailable")

# Snapper

rc, snapshots = run("snapper", "-c", "root", "list")

check("Snapshot Management",
      "PASS" if rc == 0 else "WARN",
      "Snapper accessible; recovery not tested" if rc == 0
      else "Snapshot management unavailable")

# Inventory export

try:
    path = Path("/var/lib/omarchy-enterprise/inventory/system.json")

    with path.open() as handle:
        inventory = json.load(handle)

    valid = isinstance(inventory, dict) and "schema_version" in inventory

    check("Inventory JSON",
          "PASS" if valid else "FAIL",
          "Valid inventory JSON" if valid else "Unexpected format")

except FileNotFoundError:
    check("Inventory JSON", "WARN", "Inventory not exported")
except (ValueError, OSError):
    check("Inventory JSON", "FAIL", "Invalid or unreadable inventory")

# Manual checks

check("Security Updates", "UNKNOWN",
      "Pending update assessment not yet implemented")

check("Endpoint Protection", "REVIEW",
      "Endpoint security agent requires verification")

check("Password Security", "REVIEW",
      "Local PAM and Active Directory policies require review")

# Report

summary = {}

for item in results:
    status = item["status"]
    summary[status] = summary.get(status, 0) + 1

report = {
    "schema_version": 1,
    "version": VERSION,
    "timestamp": datetime.now(timezone.utc).isoformat(),
    "checks": results,
    "summary": summary
}

if "--export" in sys.argv:
    import tempfile
    import stat

    os.umask(0o077)

    directory = Path("/var/lib/omarchy-enterprise/compliance")
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)

    metadata = directory.lstat()

    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) != 0o700:
        sys.exit("Unsafe compliance directory permissions.")

    temporary = None

    try:
        with tempfile.NamedTemporaryFile(
            mode="w", dir=directory, delete=False
        ) as handle:
            temporary = Path(handle.name)
            json.dump(report, handle, indent=2)
            handle.write(chr(10))

        destination = directory / "report.json"
        os.replace(temporary, destination)

        print("Security report exported successfully.")
        print(destination)

    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)

    sys.exit(0)

if "--json" in sys.argv:
    print(json.dumps(report, indent=2))
    sys.exit(0)

print("========================================")
print("   OMARCHY ENTERPRISE COMPLIANCE")
print("              v" + VERSION)
print("========================================")
print()

colors = {
    "PASS": "92",
    "WARN": "93",
    "FAIL": "91",
    "REVIEW": "96",
    "UNKNOWN": "90",
    "N/A": "90"
}

for item in results:

    status = item["status"]
    label = f"[{status:^7}]"

    if sys.stdout.isatty():
        label = f"\033[{colors[status]}m{label}\033[0m"

    print(label + " " + item["check"])
    print("          " + item["detail"])

print()
print("========================================")

for status in colors:
    print(f"{status:10}: {summary.get(status, 0)}")

print("========================================")
print("Security assessment completed.")
print("No security settings were modified.")
