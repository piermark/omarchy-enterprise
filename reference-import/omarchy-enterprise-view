#!/bin/bash
# SPDX-License-Identifier: MIT

clear

gum style \
    --foreground 212 \
    --border rounded \
    --border-foreground 212 \
    --padding "1 3" \
    --align center \
    "OMARCHY ENTERPRISE" \
    "Management Console v0.10.0"

echo

case "${1:-doctor}" in

    doctor)
        sudo /usr/local/bin/omarchy-enterprise-doctor
        ;;

    identity)
        echo "Active Directory Status"
        echo
        sudo /usr/local/bin/omarchy-enterprise-ad-testjoin
        sudo wbinfo -t
        echo
        sudo sssctl domain-list
        ;;

    kerberos)
        echo "Kerberos Single Sign-On"
        echo
        klist
        ;;

    security)
        echo "Security Status"
        echo
        lsblk -o NAME,FSTYPE,MOUNTPOINTS
        echo
        bootctl status --no-pager
        ;;

    snapshots)
        sudo snapper -c root list
        ;;

    guard)
        sudo /usr/local/bin/omarchy-enterprise-guard check
        ;;

    backup)
        sudo /usr/local/bin/omarchy-enterprise-guard list
        ;;

    certificates)
        /usr/local/bin/omarchy-enterprise-certificates list
        ;;

    printers)
        /usr/local/bin/omarchy-enterprise-printers status
        ;;

    printjobs)
        echo "Your Print Jobs"
        echo
        /usr/local/bin/omarchy-enterprise-printers jobs
        ;;

    printoptions)
        DEFAULT=$(LC_ALL=C lpstat -d | sed -n 's/^system default destination: //p')
        echo "Installed printers:"
        lpstat -p
        echo
        read -rp "Printer name [$DEFAULT]: " PRINTER
        PRINTER="${PRINTER:-$DEFAULT}"

        if [[ -n "$PRINTER" ]]; then
            /usr/local/bin/omarchy-enterprise-printers options "$PRINTER"
        fi
        ;;

    printermonitor)
        DEFAULT_HOST=$(cat /etc/omarchy-enterprise/printer-monitor-host)
        read -rp "Printer hostname [$DEFAULT_HOST]: " HOST
        HOST="${HOST:-$DEFAULT_HOST}"
        /usr/bin/python3 /usr/local/bin/omarchy-enterprise-printer-monitor "$HOST"
        ;;

    inventory)
        /usr/local/bin/omarchy-enterprise-inventory
        ;;

    inventorysoftware)
        /usr/local/bin/omarchy-enterprise-inventory --software
        ;;

    inventorynetwork)
        /usr/local/bin/omarchy-enterprise-inventory --network
        ;;

    inventoryexport)
        sudo /usr/local/bin/omarchy-enterprise-inventory --export
        ;;

    compliance)
        sudo /usr/bin/python3 /usr/local/bin/omarchy-enterprise-compliance
        ;;

    complianceexport)
        sudo /usr/bin/python3 /usr/local/bin/omarchy-enterprise-compliance --export
        ;;

    auditstatus)
        sudo /usr/local/bin/omarchy-enterprise-audit status
        ;;

    auditrules)
        sudo /usr/local/bin/omarchy-enterprise-audit rules
        ;;

    auditidentity)
        sudo /usr/local/bin/omarchy-enterprise-audit identity
        ;;

    auditconfig)
        sudo /usr/local/bin/omarchy-enterprise-audit configuration
        ;;

    auditauth)
        sudo /usr/local/bin/omarchy-enterprise-audit authentication
        ;;

    auditfailures)
        sudo /usr/local/bin/omarchy-enterprise-audit failures
        ;;

    auditsummary)
        sudo /usr/local/bin/omarchy-enterprise-audit summary
        ;;

    updates)
        /usr/local/bin/omarchy-enterprise-updates check
        ;;

    updatepreflight)
        sudo /usr/local/bin/omarchy-enterprise-updates preflight
        ;;

    updatepostflight)
        sudo /usr/local/bin/omarchy-enterprise-updates postflight
        ;;

    updatesnapshot)
        read -rp "Create recovery snapshot? [y/N] " ANSWER
        if [[ "$ANSWER" == "y" || "$ANSWER" == "Y" ]]; then
            sudo /usr/local/bin/omarchy-enterprise-updates snapshot
        fi
        ;;

    updateconfigs)
        sudo /usr/local/bin/omarchy-enterprise-updates config-review
        ;;

    updatehistory)
        sudo /usr/local/bin/omarchy-enterprise-updates history
        ;;

    policy)
        /usr/local/bin/omarchy-enterprise-policy plan
        ;;

    policyrefresh)
        /usr/local/bin/omarchy-enterprise-policy apply
        ;;

    policyvalidate)
        /usr/local/bin/omarchy-enterprise-policy validate
        ;;

    *)
        echo "Unknown module."
        exit 1
        ;;

esac

echo
read -rp "Press ENTER to close..."
