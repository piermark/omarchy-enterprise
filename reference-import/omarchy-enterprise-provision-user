# Parse JSONC without removing comments from the original file.
source = menu.read_text() if menu.exists() else "{}\n"

pattern = re.compile(
    r'"(?:\\.|[^"\\])*"|//[^\r\n]*|/\*[\s\S]*?\*/'
    r'|\s+|[{}\[\],:]|[^{}\[\],:\s"/]+|.'
)

tokens = [
    m for m in pattern.finditer(source)
    if not m.group().isspace()
    and not m.group().startswith(("//", "/*"))
]

clean = " ".join(
    token.group()
    for i, token in enumerate(tokens)
    if not (
        token.group() == ","
        and i + 1 < len(tokens)
        and tokens[i + 1].group() in ("}", "]")
    )
)

current = json.loads(clean)

if not isinstance(current, dict):
    sys.exit("Invalid Omarchy menu configuration.")

# Preserve existing entries and user customizations.
missing = {
    key: value for key, value in entries.items()
    if key not in current
}

if missing:
    backup = menu.with_name(menu.name + ".pre-enterprise")

    if menu.exists() and not backup.exists():
        with backup.open("x") as handle:
            handle.write(source)

    position = tokens[-1].start()

    prefix = (
        "" if tokens[-2].group() in ("{", ",")
        else ","
    )

    additions = json.dumps(
        missing, indent=2, ensure_ascii=False
    )[1:-1].strip("\n")

    updated = (
        source[:position]
        + prefix + "\n"
        + additions + "\n"
        + source[position:]
    )

    with tempfile.NamedTemporaryFile(
        mode="w",
        dir=menu.parent,
        delete=False
    ) as handle:
        handle.write(updated)
        temporary = handle.name

    os.replace(temporary, menu)

    print("Enterprise menu provisioned successfully.")
else:
    print("Enterprise menu already configured.")

if "--no-refresh" not in sys.argv:
    try:
        subprocess.run(
            ["/usr/bin/omarchy-menu", "refresh"],
            timeout=10,
            check=False
        )
    except (OSError, subprocess.TimeoutExpired):
        print("Menu refresh unavailable; configuration saved.")
