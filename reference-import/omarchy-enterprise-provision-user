    Path("/etc/omarchy-enterprise/provision.json").read_text()
)

account = pwd.getpwuid(os.getuid())
username = account.pw_name
home = Path(account.pw_dir)

domain = config["domain"].lower()
is_domain_user = username.lower().endswith("@" + domain)

def is_admin():
    if not is_domain_user:
        return False

    try:
        gid = grp.getgrnam(config["admin_group"]).gr_gid
        return gid in set(os.getgroups()) | {os.getgid()}
    except KeyError:
        return False

