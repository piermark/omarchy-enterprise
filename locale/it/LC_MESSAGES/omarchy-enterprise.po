msgstr "Definizioni delle stampanti salvate"

msgid "GTK4, Libadwaita or the graphical display is unavailable."
msgstr "GTK4, Libadwaita o il display grafico non sono disponibili."

msgid "Accept managed bookmarks"
msgstr "Accetta i preferiti gestiti"

msgid "Keep the current entries and finalize their rollback checkpoint."
msgstr "Mantieni le voci attuali e chiudi il punto di ripristino."
