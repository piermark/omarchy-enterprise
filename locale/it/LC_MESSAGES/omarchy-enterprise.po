msgstr "Usa un terminale senza privilegi per esaminare, sincronizzare o recuperare i segnalibri operativi."

msgid "Review driverless queues"
msgstr "Esamina le code senza driver"

msgid "Discover managed Windows VM"
msgstr "Individua la VM Windows gestita"

msgid "Check CUPS availability and choose queue names that are still free."
msgstr "Verifica la disponibilità di CUPS e scegli nomi di coda ancora liberi."

msgid "Windows edition (11, 11l, 11e)"
msgstr "Edizione di Windows (11, 11l, 11e)"

msgid "Loopback RDP port (optional)"
msgstr "Porta RDP su loopback (facoltativa)"

msgid "Guest certificate DNS name"
msgstr "Nome DNS del certificato del sistema guest"

msgid "Guest account"
msgstr "Account del sistema guest"

msgid "Check the image digest, resource sizes, storage path and optional guest endpoint."
msgstr "Verifica il digest dell'immagine, le risorse, il percorso di archiviazione e l'eventuale endpoint del sistema guest."

msgid "Local managed-container discovery is unavailable in this session."
msgstr "Il rilevamento dei container gestiti locali non è disponibile in questa sessione."

msgid "Use a trusted administrator terminal to review drift and available rollback or recovery. Review a fresh token before approving each action."
msgstr "Usa un terminale amministrativo fidato per verificare le modifiche esterne e le opzioni di ripristino o recupero. Esamina un token nuovo prima di ogni approvazione."

msgid "Installed queues"
msgstr "Code installate"

msgid "Windows guest connectivity"
msgstr "Connettività del sistema guest Windows"

msgid "Startup policy"
msgstr "Criteri di avvio"

msgid "Lifecycle qualification"
msgstr "Qualifica del ciclo di vita"

msgid "Managed Windows VM"
msgstr "VM Windows gestita"

msgid "Default"
msgstr "Predefinito"

msgid "This saves a private draft for the installed administrator helper."
msgstr "Salva una bozza privata per lo strumento amministrativo installato."

msgid "Save handoff"
msgstr "Salva la consegna"

msgid "Administrator handoff saved"
msgstr "Consegna all'amministratore salvata"

msgid "In a trusted administrator terminal, run the first command to review ownership, conflicts and prerequisites. Use its fresh token in the second command only after approval."
msgstr "In un terminale amministrativo fidato, esegui il primo comando per verificare proprietà, conflitti e prerequisiti. Usa il nuovo token nel secondo comando solo dopo l'approvazione."

msgid "Edit managed printer"
msgstr "Modifica stampante gestita"

msgid "Use a unique oe- queue name and a driverless IPP or IPPS endpoint."
msgstr "Usa un nome di coda univoco con prefisso oe- e un endpoint IPP o IPPS senza driver."

msgid "Add printer"
msgstr "Aggiungi stampante"

msgid "Native configuration preview"
msgstr "Anteprima della configurazione nativa"

msgid "Enrollment and interactive login require separate qualification."
msgstr "L'adesione al dominio e l'accesso interattivo richiedono una qualifica separata."

msgid "Review directory settings"
msgstr "Esamina le impostazioni della directory"

msgid "Review unavailable"
msgstr "Revisione non disponibile"

msgid "Check the SMB entries and deployment profile."
msgstr "Verifica le voci SMB e il profilo di distribuzione."

msgid "An empty policy clears the managed share list after administrator approval."
msgstr "Un criterio vuoto svuota l'elenco delle condivisioni gestite dopo l'approvazione dell'amministratore."

msgid "Printing dependencies"
msgstr "Dipendenze di stampa"

msgid "Correct the queue name and endpoint."
msgstr "Correggi il nome della coda e l'endpoint."

msgid "Check the domain, workgroup and group names."
msgstr "Verifica dominio, gruppo di lavoro e nomi dei gruppi."

msgid "Included"
msgstr "Incluse"

msgid "Optional"
msgstr "Facoltativo"

msgid "All users"
msgstr "Tutti gli utenti"

